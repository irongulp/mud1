FROM almalinux:9 AS base
RUN dnf install -y systemd git gcc make python3.12 python3.12-pip nginx openssl-devel sudo tar gzip && dnf clean all
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]

# Optional local host/browser testing; the final deployment target stays lean.
FROM base AS browser-tests
RUN dnf install -y alsa-lib atk at-spi2-atk at-spi2-core cairo cups-libs \
    libdrm libX11 libXcomposite libXdamage libXext libXfixes libXrandr \
    libxcb libxkbcommon mesa-libgbm nss pango liberation-fonts && dnf clean all
ENV VIRTUAL_ENV=/opt/mud86-test-venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/mud86-test-browsers
ENV PYTHONDONTWRITEBYTECODE=1
COPY requirements.lock requirements-dev.txt requirements-deploy.txt requirements-storage.txt /opt/mud86-test-requirements/
RUN python3.12 -m venv "$VIRTUAL_ENV" \
    && python -m pip install --upgrade pip==26.2.1 \
    && python -m pip install -r /opt/mud86-test-requirements/requirements-deploy.txt \
    && python -m pip install --require-hashes -r /opt/mud86-test-requirements/requirements-storage.txt \
    && python -m pip install -r /opt/mud86-test-requirements/requirements-dev.txt \
    && python -m pip check \
    && python -m playwright install chromium
WORKDIR /checkout
CMD ["python", "-m", "unittest", "tests.test_deployment", "tests.test_external_deployment", "tests.test_gateway", "tests.test_persona_store", "tests.test_terminal", "-v"]

FROM base AS deployment
