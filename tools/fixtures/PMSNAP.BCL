// PRIVATE migration snapshot: includes password words. Never transcript/log it.
// Original MUD is not linked; file-associated ENQ matches its native lock.
get "bcl:acs"
get "bcl:rfs"
get "bcl:iolib"
get "bcl:bits"
get "bcl:kernel"
$ldtext "/runame:pmsnap"
manifest $( HEADERWORDS=256; RECORDWORDS=12; MAXRECORDS=8192; ROWWORDS=4 $)
let start() be
$( let head=newvec(HEADERWORDS-1)
   and data,stream,length,count,check,device,file,ppn=?,?,?, ?,0,?,?,?
   writes(tty,"PMSNAP READY*C*L")
   device_octword(); file_octword(); ppn_octword()
   stream_dofile(device,file,$6".pm",ppn,label(missing),#14,2,0,0,0,0,lookup,rdb,0,closefile)
   unless lock(SC.CHANNEL^stream) close(stream)<>writes(tty,"NS1 ERROR LOCK*C*L")<>finish
   for i=0 to HEADERWORDS-1 readch(stream,head+i)
   length_head!255
   if length=0 length_HEADERWORDS
   count_(length-HEADERWORDS)/RECORDWORDS
   unless HEADERWORDS le length le HEADERWORDS+MAXRECORDS*RECORDWORDS /\
      (length-HEADERWORDS) rem RECORDWORDS=0
   $( unlock(); close(stream); writes(tty,"NS1 ERROR LENGTH*C*L"); finish $)
   data_newvec(length-1)
   for i=0 to HEADERWORDS-1 data!i_head!i
   for i=HEADERWORDS to length-1 readch(stream,data+i)
   unlock(); close(stream)
   write(tty,"NS1 BEGIN :N*C*L",length)
   for offset=0 to length-1 by ROWWORDS
   $( write(tty,"NS1 DATA :N",offset)
      for j=0 to ROWWORDS-1
      $( write(tty," :8",data!(offset+j)); check_check neqv data!(offset+j) $)
      writes(tty,"*C*L")
   $)
   write(tty,"NS1 END :N :8*C*L",length,check)
   finish
missing: writes(tty,"NS1 ERROR MISSING*C*L")
$)
and octword()=valof
$( let value,ch=0,?
   readch(tty,@ch) repeatwhile ch='*S' \/ ch='*C' \/ ch='*L'
   for i=1 to 12
   $( unless '0' le ch le '7' writes(tty,"NS1 ERROR REQUEST*C*L")<>finish
      value_(value<<3) bitor (ch-'0')
      if i ls 12 readch(tty,@ch)
   $)
   resultis value
$)
and unlock() be
$( let addr=vec 1
   !addr_#1000005; addr!1_142857
   $[ $move 1,addr; $hrli 1,1; $deq. 1,0; $trn $]
$)
and lock(chan)=valof
$( let addr=vec 4
   !addr_#1000005; addr!1_142857; addr!2_chan
   addr!3_$az"mud"+(-1<<18); addr!4_0
   resultis valof $[ $move 1,addr; $enq. 1,0; $tdza 1,1; $seto 1,0 $]
$)
